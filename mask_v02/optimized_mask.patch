+// The smoothed log-odds of the causal cache vote were already calculated in
+// SemPredBit(). Linear interpolation avoids a second per-bit FP division.
+// Cache weights are non-negative and the smoothing floor is 0.01, so the
+// log-odds are strictly inside [-log(101), log(101)] = [-4.616, 4.616].
+// Keep the EXACT original 1/256 grid over [-5, 5], 10 KiB rather than 16 KiB.
+// The original indexing arithmetic is deliberately preserved bit-for-bit.
+static double RecordFastVote(double rx) {
+  constexpr int kStart = 768;  // x = -5 in the original table
+  constexpr int kN = 2560;    // up to x = +5 inclusive
+  static float table[kN + 1] = {};
+  static bool initialized = false;
+  if (!initialized) {
+    for (int i = 0; i <= kN; ++i) {
+      const double x = ((double)(i + kStart) / 256.0) - 8.0;
+      table[i] = (float)(1.0 / (1.0 + exp(-x)));
+    }
+    initialized = true;
